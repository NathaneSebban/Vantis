# Base URL of the Vantis API. Leave empty to use same-origin relative URLs
# (works with the Vite dev proxy and the docker-compose reverse proxy).
# Set only when the API lives on a different origin, e.g. http://localhost:8000
VITE_API_BASE=

# API key — only needed if the backend has auth enabled (VANTIS_API_KEY set).
# Sent as the X-API-Key header (and ?key= for the WebSocket). Leave empty in
# local development where auth is disabled.
VITE_API_KEY=
